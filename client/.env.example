# ---------------------------------------------------------------
# Frontend environment (copy to .env.local).
# Everything prefixed VITE_ is PUBLIC and bundled into the site —
# never put secrets here.
# ---------------------------------------------------------------

# Optional hosted form service that e-mails inquiries to you (Formspree, Web3Forms, …).
# Both values are PUBLIC by design — never paste a private/secret key here.
# Leave empty and visitors get a prefilled WhatsApp / e-mail message instead.
# If you use a service other than Formspree or Web3Forms, add its origin to connect-src in vercel.json.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# Public site URL — used for canonical/OG tags, sitemap.xml and robots.txt.
VITE_SITE_URL=

# Contact details. Any value left empty is hidden on the website.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# WhatsApp number in international format, digits only (e.g. 9779800000000).
VITE_WHATSAPP_NUMBER=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_LOCATION=

# Availability badge in the hero. Leave EMPTY unless you have confirmed
# availability (e.g. "Available for new projects").
VITE_AVAILABILITY_STATUS=
