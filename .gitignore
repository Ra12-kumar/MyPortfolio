.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
secrets/
**/secrets/
credentials.json
service-account*.json
*-service-account*.json
.npmrc


