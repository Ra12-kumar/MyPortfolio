{
  "name": "rjk-portfolio-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "vitest run --pool=vmThreads",
    "lint": "node --check src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
