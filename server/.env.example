# ---------------------------------------------------------------
# Server environment. Copy to .env for local development.
# NEVER commit real values. Set these in your host's dashboard
# (Render / Railway) for production.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the app (1 for Render/Railway) — needed for correct per-IP rate limiting.
TRUST_PROXY=1

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Project Settings -> API) ---
# Service-role key bypasses RLS: server only, never in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=project-images

# --- Inquiry storage when Supabase is NOT configured ---
# Inquiries are appended to this JSONL file (relative to /server). Needs a persistent disk; use Supabase on ephemeral hosts.
INQUIRY_STORE_PATH=data/inquiries.jsonl
INQUIRY_FILE_STORE=on

# --- AI chatbot (any OpenAI-compatible Chat Completions API) ---
# Leave LLM_API_KEY empty to use the built-in rule-based fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=400
LLM_TIMEOUT_MS=20000
# Optional extra rule appended to the system prompt.
CHAT_EXTRA_INSTRUCTIONS=

# --- Optional new-inquiry e-mail notifications (Resend) ---
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
